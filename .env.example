SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@127.0.0.1:5432/racket_shop
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@racket-shop.example
SITE_URL=http://localhost:8000

# Leave PayU/Stripe credentials blank to use the local mock payment provider.
PAYU_POS_ID=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_SECOND_KEY=
PAYU_SANDBOX=True
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Seller details printed on VAT invoices - all have sane demo defaults.
STORE_LEGAL_NAME=Racket Sports Shop Sp. z o.o.
STORE_VAT_ID=PL0000000000
STORE_ADDRESS_LINE=ul. Sportowa 1
STORE_CITY_LINE=00-001 Warszawa, Poland
